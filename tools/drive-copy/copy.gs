function copyAll(){
  var start=Date.now(), done=0, skipped=0, failed=[];
  var cache={};
  for (var i=0;i<FILES.length;i++){
    if (Date.now()-start>320000){ Logger.log('TIME LIMIT — run again to continue'); break; }
    var fid=FILES[i][0], name=FILES[i][1], url=FILES[i][2];
    if(!cache[fid]){ cache[fid]={folder:DriveApp.getFolderById(fid), names:{}}; var it=cache[fid].folder.getFiles(); while(it.hasNext()){cache[fid].names[it.next().getName()]=1;} }
    if(cache[fid].names[name]){ skipped++; continue; }
    try{ var r=UrlFetchApp.fetch(url,{muteHttpExceptions:true});
      if(r.getResponseCode()!=200){ failed.push(name+' '+r.getResponseCode()); continue; }
      cache[fid].folder.createFile(r.getBlob().setName(name)); cache[fid].names[name]=1; done++;
    }catch(e){ failed.push(name+' '+e); }
  }
  Logger.log('done '+done+', skipped '+skipped+', failed '+failed.length+' of '+FILES.length);
  if(failed.length) Logger.log(failed.join('\n'));
}